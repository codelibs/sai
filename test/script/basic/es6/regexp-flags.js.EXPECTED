no flags          = ''
g                 = 'g'
i                 = 'i'
m                 = 'm'
gim               = 'gim'
y                 = 'y'
gimy              = 'gimy'
igm -> gim        = 'gim'
mig -> gim        = 'gim'
ygmi -> gimy      = 'gimy'
new RegExp('x','mg') = 'gm'
new RegExp('x','yg') = 'gy'
toString          = '/x/gimy'
own on instance   = true
value             = 'gi'
writable          = false
enumerable        = false
configurable      = true
proto.flags       = ''
after assignment  = 'gi' ''
strict assignment = true
